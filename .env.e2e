# The e2e build (`npm run test:e2e`) gets cloud sync pointed at a host that does not exist; e2e/sync.e2e.ts
# answers it with a fake Supabase, and the network guard in e2e/fixtures.ts fails any test that reaches it otherwise.
VITE_SUPABASE_URL=https://sync.e2e.test
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e
